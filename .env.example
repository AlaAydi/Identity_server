# Template de variables d'environnement (À dupliquer en .env)
DB_URL=jdbc:postgresql://localhost:5432/identity_server
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE

# Configuration JWT (Changer le Secret en Production !)
JWT_SECRET=YOUR_SUPER_SECRET_KEY_MINIMUM_256_BITS_CHANGE_THIS_IN_PRODUCTION
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
